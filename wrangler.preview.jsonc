{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanoshitest-portal-demo-showcase-preview",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portal-demo-showcase-preview-db",
      "database_id": "6e9643f3-4644-44ec-8af8-e9226594d198",
      "migrations_dir": "migrations",
    },
  ],
}
